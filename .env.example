# ==============================================================================
# Apex Operations API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env (Linux/macOS) OR copy .env.example .env (Windows)
# NOTE: Never commit the actual .env file to version control.
# ==============================================================================

# Application Settings
APP_NAME=Apex Operations API
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
APP_IMAGE_TAG=v1.0.0
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
DB_HOST=apex-db
DB_PORT=5432
DB_NAME=apex_ops_db
DB_USER=apex_user
DB_PASSWORD=apex_secure_dev_password_change_me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Optional: Full Database URL override (e.g. for cloud or SQLite testing)
# DATABASE_URL=postgresql://apex_user:apex_secure_dev_password_change_me@apex-db:5432/apex_ops_db
